# Copie para .env e troque os valores. Nunca commite o .env.

# Aplicação
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
API_PORT=3000
LOG_LEVEL=info

# Banco e cache (docker compose up -d)
DATABASE_URL=postgresql://safe:safe@localhost:5432/safe
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
TEST_DATABASE_URL=postgresql://safe:safe@localhost:5432/safe_test

# Segredos: gere com
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SESSION_SECRET=troque-por-32-bytes-aleatorios-em-base64

# Login com Google (T-00.2)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback

# Versões vigentes dos documentos legais (mudou → todos aceitam de novo)
PRIVACY_VERSION=1.0
TERMS_VERSION=1.0
