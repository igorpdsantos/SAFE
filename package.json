{
  "name": "safe",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:coverage": "npm run test:coverage -w backend",
    "test:e2e": "npm run test:e2e -w frontend",
    "db:migrate": "npm run db:migrate -w backend",
    "tasks": "node scripts/tasks-status.mjs",
    "privacy:reapply-deletions": "npm run privacy:reapply-deletions -w backend",
    "dev:demo": "concurrently -k -n api,web -c blue,green \"npm run dev:demo -w backend\" \"npm run dev -w frontend\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
